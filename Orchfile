ARG HUM_SRC=
ARG IKSIR_STATE_DIR=
ARG IKSIR_REPO_PATH=

SERVICE hive-install
RUN ${HUM_SRC}/install
ONESHOT true

SERVICE iksir
RUN node --env-file-if-exists=${HUM_SRC}/.env ${HUM_SRC}/src/main.ts
ENV IKSIR_STATE_DIR=${IKSIR_STATE_DIR}
ENV IKSIR_REPO_PATH=${IKSIR_REPO_PATH}
RESTART always

SERVICE saail
RUN node --env-file-if-exists=${HUM_SRC}/.env ${HUM_SRC}/hives/saail/saail.ts
ENV IKSIR_STATE_DIR=${IKSIR_STATE_DIR}
RESTART always
