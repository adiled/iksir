# Private content
/*.md
!/README.md
/docs
/graveyard
/backlog

# Secrets never ride the repo; iksir keeps none here (they live in ~/.config/iksir/asrar).
# A .env left over from before is dead to iksir, and stays dead to git.
.env
*.pem
*.key

# Logs
logs/
*.log
*.pid

# Editor
.zed/

# Old/backup files
*.old.ts
*.bak
*.backup

# VPN/Proxy (local infrastructure)
vpn/

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# npm
node_modules/
package-lock.json

# The Sijill never rides the repo
*.sqlite
*.sqlite-wal
*.sqlite-shm
